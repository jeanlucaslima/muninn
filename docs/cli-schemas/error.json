{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muninn.local/cli-schemas/error.json",
  "title": "error.json",
  "description": "Every failure with --json: this object on stderr, nothing on stdout. The exit code carries the category (§4.11 contract rule 2).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "common.json#/$defs/schemaVersion"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable error code, e.g. usage, not_found, helper_unreachable, incompatible, busy, internal."
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "error"
  ],
  "additionalProperties": false
}
